# Copy to .env and fill in for your workspace: cp .env.template .env
# Each key (except databricks_profile) is passed to the bundle as --var key=value.

# Databricks CLI profile from ~/.databrickscfg used by scripts/deploy.sh
databricks_profile=DEFAULT

# Unity Catalog catalog for Bronze/Silver tables
catalog=main

# Lakebase Postgres role/username for JDBC connections
# This is the Lakebase user identity (typically your email or 'admin')
lakebase_role=admin
